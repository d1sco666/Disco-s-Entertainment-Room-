# Environment variables for Entertainment Room

# TMDB API configuration
# VITE_ values are embedded in the public browser bundle. Use a key intended for
# client-side use and restrict it to your site where possible.
VITE_TMDB_API_KEY=your_tmdb_v3_api_key

# Vimeus view key for embeds (included in the public embed URL by design)
VITE_VIMEUS_VIEW_KEY=your_vimeus_view_key

# Simkl OAuth 2.0 public client ID
VITE_SIMKL_CLIENT_ID=5b98b5163aa1a1606f1ddf4cfe476affe3fb20150ac05f38a229325723f72241

# MyAnimeList OAuth 2.0 public client ID
VITE_MAL_CLIENT_ID=8d96d1c3e67e9cbeb6acb455a254ebcd

# Auth0 SPA configuration
# Create a Single Page Application in Auth0 and configure allowed callback,
# logout, and web origins for your local and deployed URLs.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
# Optional: set this when your Auth0 API requires an audience.
VITE_AUTH0_AUDIENCE=